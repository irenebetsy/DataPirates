# Copy this file to .env and fill in your own PostgreSQL details.
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SERVER=localhost
DB_PORT=5432
DB_NAME=DataPirates
PORT=3000

# Set to "false" only for a local Postgres install without SSL configured.
# Leave "true" for Render/Neon/Supabase - they require SSL.
DB_SSL=true

# Email settings for "Forgot Password"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRONTEND_URL=http://localhost:3000
